# ═══════════════ SQL Detective: variables de entorno ═══════════════
# Copia este archivo como .env.local (local) o configura las variables en Vercel → Settings → Environment Variables.

# Conexión principal a PostgreSQL (rol propietario de la base).
# En Neon usa la cadena "Pooled connection" (host con -pooler) y sslmode=require.
DATABASE_URL=postgresql://USUARIO:CONTRASEÑA@HOST/BASE?sslmode=require

# Contraseña del rol aislado «sqld_sandbox», que ejecuta las consultas de los estudiantes.
# npm run db:seed lo crea con esta contraseña. Usa 24+ caracteres aleatorios.
SANDBOX_DB_PASSWORD=

# (Opcional) Cadena completa para el rol aislado. Si no se define, se deriva de DATABASE_URL
# reemplazando usuario y contraseña por sqld_sandbox / SANDBOX_DB_PASSWORD.
# SANDBOX_DATABASE_URL=

# Secretos del servidor (mínimo 32 caracteres aleatorios cada uno). Nunca se envían al navegador.
#   Genera uno con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
REPORT_SIGNING_SECRET=

# (Opcional) Docente inicial creado durante el build de Vercel. Bórralo después del primer despliegue.
# ADMIN_USERNAME=docente
# ADMIN_PASSWORD=

# (Opcionales) Ajustes avanzados
# SEED_ON_BUILD=false          # true = recargar los 15 casos en cada build
# SQLD_ROLE_PREFIX=sqld        # prefijo de los roles de PostgreSQL (útil si compartes el clúster)
# SQL_TIMEOUT_MS=4000          # tiempo máximo por consulta de estudiante
# QUERY_RATE_PER_MIN=30        # consultas máximas por minuto y por investigación
# PG_POOL_MAX=5
# PG_SANDBOX_POOL_MAX=4
